    %19 = VPURT.DeclareBuffer <CMX_NN> [0] <65536> {swizzlingKey = 5 : i64} -> memref<128x256x1x1xf16, {order = #NHWC, swizzlingScheme = #VPUIP.SwizzlingSchemeAttr<key = 5 : i64, sizeAlignment = 1024 : i64>}, [@CMX_NN, 0]>
