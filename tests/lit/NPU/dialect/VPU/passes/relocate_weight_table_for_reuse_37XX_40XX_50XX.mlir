    // CHECK-SAME{LITERAL}:    [[[1920, 16777215, 1065353216, 0]]]], [[[[0, 16777215, 1065353216, 0]]],
    // CHECK-SAME{LITERAL}:    [[[1920, 16777215, 1065353216, 0]]]], [[[[0, 16777215, 1065353216, 0]]],
    // CHECK-SAME{LITERAL}:    [[[1792, 16777215, 1065353216, 0]]], [[[1920, 16777215, 1065353216, 0]]]]]> : tensor<8x16x1x1x4xsi32>

    // CHECK:                [[DISTR_WEIGHTS_TABLE:%.+]] = VPU.UnrolledType([[WEIGHTS_TABLE]] : tensor<8x16x1x1x4xsi32>)

    // CHECK:                VPU.NCE.MatMul({{%.+}}, {{%.+}}, [[DISTR_WEIGHTS_TABLE]])
