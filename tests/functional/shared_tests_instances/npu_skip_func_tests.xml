<skip_configs>
    <!-- E#111555 -->
    <skip_config>
        <message>IfTest segfaults npuFuncTest on Ubuntu</message>
        <enable_rules>
            <backend>LEVEL0</backend>
            <device>3720</device>
            <device>4000</device>
            <device>5010</device>
            <operating_system>linux</operating_system>
        </enable_rules>
        <filters>
            <filter>.*smoke_IfTest.*</filter>
        </filters>
    </skip_config>

    <!-- E#171305 -->
    <skip_config>
        <message>Dynamic output issue in sync infer request where keepDims is off</message>
        <filters>
            <filter>.*smoke_ReduceAllAxis/ReduceLayerTest_SW_FP16.*KeepDims=0.*</filter>
        </filters>
    </skip_config>

    <!-- E#109040 -->
    <skip_config>
        <!-- Test is only instantiated for NPU3720 -->
        <message>Skip tests that can not run when DRIVER is default compiler type</message>
        <filters>
            <filter>.*MatMulTransposeConcatTest.*</filter>
        </filters>
    </skip_config>

    <!-- E#215114 -->
    <skip_config>
        <message>Output I4 / U4 precision is not currently supported.</message>
        <filters>
            <filter>.*smoke.*OVInferRequestCheckTensorPrecision.*type=i4.*</filter>
            <filter>.*smoke.*OVInferRequestCheckTensorPrecision.*type=u4.*</filter>
            <filter>.*smoke.*OVInferRequestIOTensorSetPrecisionTestNPU.*type=i4.*</filter>
            <filter>.*smoke.*OVInferRequestIOTensorSetPrecisionTestNPU.*type=u4.*</filter>
        </filters>
    </skip_config>

    <!-- E#156587 -->
    <skip_config>
        <message>ShaveCodeGen is currently working only on Ubuntu, skipping for Windows</message>
        <enable_rules>
            <operating_system>windows</operating_system>
        </enable_rules>
        <filters>
            <filter>.*ShaveCodeGen.*</filter>
        </filters>
    </skip_config>

    <!-- E#170866 -->
    <skip_config>
        <message>LSTM Sequence accuracy fails</message>
        <enable_rules>
        </enable_rules>
        <filters>
            <filter>.*smoke_precommit_LSTMSequencePt/LSTMSequenceLayerTestCommon.*</filter>
            <filter>.*smoke_precommit_LSTMSequencePtConst/LSTMSequenceLayerTestCommon.*</filter>
            <filter>.*smoke_precommit_LSTMSequenceAccuracy/LSTMSequenceLayerTestCommon.*</filter>
            <filter>.*smoke_precommit_LSTMSequenceCommonZeroClip/LSTMSequenceLayerTestCommon.*</filter>
        </filters>
    </skip_config>

    <!-- E#185858 -->
    <skip_config>
        <message>LSTM Sequence scenario with PARAM input 'sequence_lengths' should not be supported on this platform, because it is not decomposed into LSTMCells. This platform should support only decomposed cases.</message>
        <enable_rules>
            <device>3720</device>
            <backend>IMD</backend>
            <backend>LEVEL0</backend>
        </enable_rules>
        <filters>
            <filter>.*smoke_precommit_LSTMSequenceCommonZeroClip/LSTMSequenceLayerTestCommon.NPU3720_HW/mode=PURE_SEQ_RAND_SEQ_LEN_PARAM_.*</filter>
            <filter>.*smoke_precommit_LSTMSequencePt/LSTMSequenceLayerTestCommon.NPU3720_HW/mode=PURE_SEQ_RAND_SEQ_LEN_PARAM_.*</filter>
            <filter>.*smoke_precommit_LSTMSequencePtConst/LSTMSequenceLayerTestCommon.NPU3720_HW/mode=PURE_SEQ_RAND_SEQ_LEN_PARAM_.*</filter>
            <filter>.*smoke_precommit_LSTMSequenceAccuracy/LSTMSequenceLayerTestCommon.NPU3720_HW/mode=PURE_SEQ_RAND_SEQ_LEN_PARAM_.*</filter>
        </filters>
    </skip_config>

    <!-- E#170977 -->
    <skip_config>
        <message>Data type u1/u2/nf4 not supported by NPU3720.</message>
        <enable_rules>
            <device>3720</device>
        </enable_rules>
        <filters>
            <filter>.*InferRequestCheckTensorPrecision.*type=u1\D.*</filter>
            <filter>.*InferRequestCheckTensorPrecision.*type=u2.*</filter>
            <filter>.*InferRequestIOTensorSetPrecisionTest.*type=u1\D.*</filter>
            <filter>.*InferRequestIOTensorSetPrecisionTest.*type=u2.*</filter>
            <filter>.*ConversionLayerTestCommon.*=u2.*</filter>
            <filter>.*ConversionLayerTestCommon.*=nf4.*</filter>
        </filters>
    </skip_config>

    <!-- E#182933 -->
    <skip_config>
        <message>Data type FP8 not supported by NPU3720/NPU4000 Shave.</message>
        <enable_rules>
            <device>3720</device>
            <device>4000</device>
        </enable_rules>
        <filters>
            <filter>.*ConversionLayerTestCommon.*f8.*</filter>
        </filters>
    </skip_config>

    <!-- E#187909 -->
    <skip_config>
        <message>Data type u1 not supported by NPU4000.</message>
        <enable_rules>
            <device>4000</device>
        </enable_rules>
        <filters>
            <filter>.*InferRequestCheckTensorPrecision.*type=u1\D.*</filter>
            <filter>.*InferRequestIOTensorSetPrecisionTest.*type=u1\D.*</filter>
        </filters>
    </skip_config>
    <!-- E#192507 -->
    <!-- E#188471 -->
    <skip_config>
        <message>Fails after OV commit update. To be investigated with E#188471</message>
        <filters>
            <filter>.*smoke_DynamicConcatOptimized/DynamicConcatLayerTest.*BoundedShape=\{1_1_1_128\}_\{\{1_1_1_128\}\}.*</filter>
        </filters>
    </skip_config>

    <!-- E#208928 -->
    <skip_config>
        <message>smoke_DynamicShapes_SCF_AutoUnroll fails on Linux.</message>
        <enable_rules>
            <operating_system>linux</operating_system>
        </enable_rules>
        <filters>
            <filter>.*smoke_DynamicShapes_SCF_AutoUnroll.*</filter>
        </filters>
    </skip_config>

    <!-- E#229812 -->
    <skip_config>
        <message>New HostCompile dynamic DMA functional tests (Interpolate/Atan) fail on Linux</message>
        <enable_rules>
            <operating_system>linux</operating_system>
        </enable_rules>
        <filters>
            <filter>.*InterpolateSAPStaticInputLayerTest\.NPU4000_HC.*</filter>
            <filter>.*InterpolateSAPStaticInputLayerTest\.NPU5010_HC.*</filter>
            <filter>.*InterpolateSAPDynInputLayerTest\.NPU4000_HC.*</filter>
            <filter>.*InterpolateSAPDynInputLayerTest\.NPU5010_HC.*</filter>
            <filter>.*DynamicActivationLayerTest_HC_FP16\.NPU4000_HC.*</filter>
            <filter>.*DynamicActivationLayerTest_HC_FP16\.NPU5010_HC.*</filter>
        </filters>
    </skip_config>

    <!-- E#211625-->
    <skip_config>
        <message>Interpreter does not support mutable command list.</message>
        <filters>
            <filter>.*interpreter_runtime/NPUVMRuntimeCAPITest.UpdateMutableCommandList.*</filter>
        </filters>
    </skip_config>

    <!-- E#211620-->
    <skip_config>
        <message>Interpreter does not support shape prediction.</message>
        <filters>
            <filter>.*interpreter_runtime/NPUVMRuntimeCAPITest.PredictShape.*</filter>
        </filters>
    </skip_config>

    <!-- E#218128-->
    <skip_config>
        <message>Added to a wrong platform config, thus never validated on CI and fails.</message>
        <enable_rules>
            <device>5010</device>
        </enable_rules>
        <filters>
            <filter>.*QuantizedConvClampSubGraphTest.*</filter>
        </filters>
    </skip_config>
</skip_configs>
